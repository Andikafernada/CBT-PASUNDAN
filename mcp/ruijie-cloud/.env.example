# ==============================================================================
# RUIJIE CLOUD MCP SERVER CONFIGURATION
# ==============================================================================

# Region Base URL:
# - Asia / Indonesia: https://cloud-as.ruijienetworks.com
# - Global / US:     https://cloud-us.ruijienetworks.com
# - Europe:          https://cloud-eu.ruijienetworks.com
RUIJIE_BASE_URL=https://cloud-as.ruijienetworks.com

# Authentication Mode: "apikey" (Developer OpenAPI) or "account" (Direct Cloud Account)
RUIJIE_AUTH_MODE=apikey

# ------------------------------------------------------------------------------
# Mode 1: OpenAPI Developer Credentials (Recommended)
# Dapatkan dari developer platform Ruijie Cloud
# ------------------------------------------------------------------------------
RUIJIE_APP_ID=
RUIJIE_APP_SECRET=
RUIJIE_API_TOKEN=

# ------------------------------------------------------------------------------
# Mode 2: Direct Ruijie Cloud Account Login
# Digunakan jika belum memiliki akses OpenAPI resmi
# ------------------------------------------------------------------------------
RUIJIE_USERNAME=
RUIJIE_PASSWORD=

# ------------------------------------------------------------------------------
# Advanced Settings
# ------------------------------------------------------------------------------
# Durasi cache token dalam detik (default: 1800 = 30 menit)
RUIJIE_TOKEN_TTL_SECONDS=1800

# Request timeout dalam detik
RUIJIE_TIMEOUT_SECONDS=30
